# PhishGuard AI - Environment Configuration Template
# Copy this file to backend/.env and populate with your credentials

# NVIDIA NIM / OpenAI API Configuration for Generative LLM Reasoning
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional External Threat Intelligence Keys
IPINFO_TOKEN=
MAXMIND_LICENSE_KEY=
VIRUSTOTAL_API_KEY=
ANTHROPIC_API_KEY=
